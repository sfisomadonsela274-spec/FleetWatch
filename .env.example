# ==============================================================================
# FleetWatch Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OUTBOUND SMTP EMAIL CONFIGURATION (Driver Passes & In-Cab OTP Codes)
# ------------------------------------------------------------------------------
# Choose your provider and configure below:

# OPTION A: SendGrid REST API (Recommended for Render — Port 443 HTTPS, 100 free emails/day)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key
EMAIL_FROM=smxtechnologies1@gmail.com
EMAIL_FROM_NAME=FleetWatch Operations

# OPTION B: Google Gmail SMTP (Note: Render free tier blocks outbound Port 587/465 SMTP)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# EMAIL_FROM=your_email@gmail.com
# EMAIL_FROM_NAME=FleetWatch Operations

# OPTION C: Postmark
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=your_postmark_server_token
# SMTP_PASS=your_postmark_server_token
# EMAIL_FROM=dispatch@yourdomain.co.za
# EMAIL_FROM_NAME=FleetWatch Operations

# OPTION D: Amazon SES (Simple Email Service)
# SMTP_HOST=email-smtp.af-south-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your_ses_smtp_user
# SMTP_PASS=your_ses_smtp_password
# EMAIL_FROM=dispatch@yourdomain.co.za
# EMAIL_FROM_NAME=FleetWatch Operations

# ------------------------------------------------------------------------------
# 2. SERVER & AUTHENTICATION
# ------------------------------------------------------------------------------
PORT=8001
HOST=0.0.0.0
FLEETSENTINEL_BEARER_TOKEN=fleetsentinel_pilot_secret_token_2026
DATABASE_URL=sqlite:///./fleetsentinel.db

# ------------------------------------------------------------------------------
# 3. APK DOWNLOAD & PUBLIC DOMAIN DISTRIBUTION (Included in driver dispatch emails)
# ------------------------------------------------------------------------------
# Default fallback: http://127.0.0.1:4000/download/FleetSentinel-Driver.apk
# When testing on local Wi-Fi / LAN devices:
# APK_DOWNLOAD_BASE_URL=http://<YOUR_LAN_IP>:4000/download
# When deploying with production CDN (GitHub Releases or Cloudflare R2):
APK_DOWNLOAD_URL=https://github.com/sfisomadonsela274-spec/FleetWatch/releases/download/v1.0.0/FleetSentinel-Driver.apk

