<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:padding="20dp"
    tools:context=".MainActivity">

    <!-- Header / Brand -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primary"
        android:padding="20dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/corridor_name"
            android:textColor="@color/accent_emerald"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/corridor_sub"
            android:textColor="#94A3B8"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Vehicle & Driver Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_surface"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvDriverInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/driver_label"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTruckInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/truck_label"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Telemetry Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_surface"
        android:padding="16dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_service_active"
            android:textColor="@color/emerald_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQueueDepth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Offline SQLite Buffer: 0 pings queued"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnToggleTracking"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btn_start_tracking"
        android:backgroundTint="@color/accent_emerald"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnBatteryWhitelist"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/btn_battery_whitelist"
        android:backgroundTint="@color/primary"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnForceSync"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/btn_force_sync"
        android:backgroundTint="#64748B"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnUnpair"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Unpair / Switch Assigned Vehicle"
        android:backgroundTint="@color/card_surface"
        android:textColor="@color/rose_alert"
        android:textSize="13sp" />

</LinearLayout>
