<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true"
    tools:context=".PairingActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header / Brand -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/primary"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FleetSentinel In-Cab"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Driver In-Cab Access"
                android:textColor="@color/accent_emerald"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Authenticate via Email OTP or direct in-cab code to start live journey tracking"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- STAGE 1: PHONE NUMBER INPUT -->
        <LinearLayout
            android:id="@+id/layoutPhoneStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_surface"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Driver Email or Mobile Number"
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter the email address or cell number registered with dispatch to receive your login code."
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/etPhoneNumber"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@color/background_light"
                android:gravity="center"
                android:hint="driver@logistics.co.za or 082..."
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="@color/text_main"
                android:textColorHint="#94A3B8"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRequestOtp"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Request Login Code via Email / SMS"
                android:backgroundTint="@color/accent_emerald"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="12dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E2E8F0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  OR  "
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E2E8F0" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDirectCodeEntry"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="🔑 Have In-Cab Code? Enter Code Directly"
                android:backgroundTint="@color/primary"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- STAGE 2: OTP / IN-CAB CODE VERIFICATION (Initially GONE) -->
        <LinearLayout
            android:id="@+id/layoutOtpStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_surface"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter 6-Digit In-Cab Code"
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOtpPhoneTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter code from your dispatch pass or email"
                android:textColor="@color/accent_emerald"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/etOtpCode"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@color/background_light"
                android:gravity="center"
                android:hint="000-000"
                android:inputType="number"
                android:letterSpacing="0.25"
                android:maxLength="7"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="@color/text_main"
                android:textColorHint="#94A3B8"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/btnVerifyOtp"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Verify &amp; Start Tracking"
                android:backgroundTint="@color/accent_emerald"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/tvResendOtp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resend Code"
                    android:textColor="@color/accent_emerald"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvChangePhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change Identifier"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Shared Error & Loading Status -->
        <TextView
            android:id="@+id/tvPairingError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/rose_alert"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            tools:text="Invalid SMS verification code. Please check SMS." />

        <ProgressBar
            android:id="@+id/pairingProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Server Endpoint Configuration (Foldable/Adjustable for Local Testing) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_surface"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvToggleServerConfig"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙ Network Server Endpoint (Tap to edit)"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="https://fleetwatch-an0h.onrender.com"
                android:textColor="@color/text_main"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:layout_marginTop="6dp"
                android:inputType="textUri"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Compliance Notice -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔒 FleetSentinel In-Cab Telemetry Protocol\nAutonomous corridor geofencing and RTMS compliance begin upon in-cab OTP verification."
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
