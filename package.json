{
  "name": "fleetwatch",
  "version": "1.0.0",
  "description": "FleetWatch - South African Autonomous Fleet Telemetry & Driver Compliance Engine",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node server/tests/api.test.js",
    "backend:fastapi": "python3 -m uvicorn backend.main:app --host 0.0.0.0 --port 8000 --reload",
    "test:backend": "PYTHONPATH=. python3 backend/tests/test_api.py",
    "simulate:edge": "python3 mobile/simulator/driver_handset_edge.py"
  },
  "keywords": [
    "telemetry",
    "logistics",
    "south-africa",
    "n4-corridor",
    "anti-siphoning",
    "rtms",
    "postgis",
    "turf"
  ],
  "author": "FleetWatch Logistics Tech",
  "license": "ISC",
  "dependencies": {
    "@turf/turf": "^7.2.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  }
}
